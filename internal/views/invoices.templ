package views

import (
	"fmt"

	"ginvoice/internal/store"
)

// isSelected returns "selected" if the condition is true, empty string otherwise.
func isSelected(condition bool) string {
	if condition {
		return "selected"
	}
	return ""
}
// InvoicesPage renders the full invoices list page.
templ InvoicesPage(invoices []store.Invoice) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<title>Invoices — ginvoice</title>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body>
			@Nav()
			<main class="container">
				<h1>Invoices</h1>
			<p><a href="/invoices/new" class="btn btn-success">Create Invoice</a></p>
				if len(invoices) == 0 {
					<p>No invoices yet. Create your first invoice to get started.</p>
				} else {
					<table id="invoices-table">
						<thead>
							<tr>
								<th>Number</th>
								<th>Client</th>
								<th>Issue Date</th>
								<th>Due Date</th>
								<th>Status</th>
								<th>Total</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, inv := range invoices {
								@InvoiceRow(inv)
							}
						</tbody>
					</table>
				}
			</main>
		</body>
	</html>
}

// InvoiceRow renders a single table row for an invoice.
templ InvoiceRow(inv store.Invoice) {
	<tr id={ fmt.Sprintf("invoice-row-%d", inv.ID) }>
		<td>{ inv.Number }</td>
		<td>{ inv.Client.Name }</td>
		<td>{ inv.IssueDate }</td>
		<td>{ inv.DueDate }</td>
		<td><span class={ "badge badge-" + inv.Status }>{ inv.Status }</span></td>
		<td>{ formatCents(inv.Total) }</td>
		<td>
			<a href={ templ.URL(fmt.Sprintf("/invoices/%d", inv.ID)) } class="btn">View</a>
			if inv.Status == "draft" {
				<a href={ templ.URL(fmt.Sprintf("/invoices/%d/edit", inv.ID)) } class="btn btn-secondary">Edit</a>
			}
		</td>
	</tr>
}

// InvoiceForm renders the new/edit invoice form with client select and line items.
// action is "/invoices" for create or "/invoices/{id}" for update.
templ InvoiceForm(clients []store.Client, services []store.Service, invoice store.Invoice, action string) {
	<form method="post" action={ templ.URL(action) } class="card">
		<div class="form-group">
			<label for="client_id">Client *</label>
			<select id="client_id" name="client_id" required>
				<option value="">Select a client</option>
				for _, c := range clients {
					<option value={ fmt.Sprintf("%d", c.ID) } { isSelected(c.ID == invoice.ClientID) }>
						{ c.Name }
						if c.Email != "" {
							({ c.Email })
						}
					</option>
				}
			</select>
		</div>

		<div class="form-row">
			<div class="form-group">
				<label for="issue_date">Issue Date *</label>
				<input type="date" id="issue_date" name="issue_date" value={ invoice.IssueDate } required/>
			</div>
			<div class="form-group">
				<label for="due_date">Due Date</label>
				<input type="date" id="due_date" name="due_date" value={ invoice.DueDate }/>
			</div>
		</div>

		<div class="form-group">
			<label for="tax_rate_pct">Tax Rate (%)</label>
			<input type="number" step="0.01" min="0" id="tax_rate_pct" name="tax_rate_pct"
				value={ fmt.Sprintf("%.2f", float64(invoice.TaxRate)/100) }/>
		</div>

		<div class="form-group">
			<label for="notes">Notes</label>
			<textarea id="notes" name="notes">{ invoice.Notes }</textarea>
		</div>

		<h3>Line Items</h3>
		<div id="line-items">
			if len(invoice.Lines) == 0 {
				@InvoiceLineRow(0, store.InvoiceLine{}, services)
			} else {
				for i, line := range invoice.Lines {
					@InvoiceLineRow(i, line, services)
				}
			}
		</div>
		<button type="button" class="btn btn-success" hx-get="/invoices/line-item" hx-target="#line-items" hx-swap="beforeend">
			Add Line Item
		</button>

		<div class="form-actions">
			<button type="submit">Save Invoice</button>
			<a href="/invoices" class="btn btn-secondary">Cancel</a>
		</div>
	</form>
}

// InvoiceLineRow renders a single line item row for the form.
templ InvoiceLineRow(index int, line store.InvoiceLine, services []store.Service) {
	<div class="line-item" id={ fmt.Sprintf("line-item-%d", index) }>
		<div class="form-group">
			<label for={ fmt.Sprintf("line_service_id_%d", index) }>Service *</label>
			<select id={ fmt.Sprintf("line_service_id_%d", index) } name={ fmt.Sprintf("line_service_id[%d]", index) } required>
				for _, s := range services {
					<option value={ fmt.Sprintf("%d", s.ID) } { isSelected(line.ServiceID != nil && *line.ServiceID == s.ID) }>
						{ s.Name } - { formatCents(s.DefaultUnitPrice) }
					</option>
				}
			</select>
		</div>
		<div class="form-group">
			<label for={ fmt.Sprintf("line_qty_%d", index) }>Quantity *</label>
			<input type="number" step="0.25" min="0" id={ fmt.Sprintf("line_qty_%d", index) } name={ fmt.Sprintf("line_qty[%d]", index) }
				value={ fmt.Sprintf("%.2f", line.Quantity) } required/>
		</div>
	</div>
}

// InvoiceLineRowPartial renders a single line item row for HTMX partial loading.
templ InvoiceLineRowPartial(index int, services []store.Service) {
	@InvoiceLineRow(index, store.InvoiceLine{}, services)
}

// NewInvoicePage renders a blank invoice form for creating an invoice.
templ NewInvoicePage(clients []store.Client, services []store.Service, invoice store.Invoice) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<title>New Invoice — ginvoice</title>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body>
			@Nav()
			<main class="container">
				<h1>Create Invoice</h1>
				@InvoiceForm(clients, services, invoice, "/invoices")
			</main>
		</body>
	</html>
}

// InvoicePage renders a single invoice in read-only view mode.
templ InvoicePage(inv store.Invoice) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<title>{ inv.Number } — ginvoice</title>
			<link rel="stylesheet" href="/static/style.css"/>
		</head>
		<body>
			@Nav()
			<main class="container">
				<h1>Invoice { inv.Number }</h1>
				<div class="invoice-details">
					<p><strong>Status:</strong> <span class={ "badge badge-" + inv.Status }>{ inv.Status }</span></p>
					<p><strong>Client:</strong> { inv.Client.Name }</p>
					if inv.Client.Email != "" {
						<p><strong>Email:</strong> { inv.Client.Email }</p>
					}
					<p><strong>Issue Date:</strong> { inv.IssueDate }</p>
					<p><strong>Due Date:</strong> { inv.DueDate }</p>
					<p><strong>Currency:</strong> { inv.Currency }</p>
					if inv.Notes != "" {
						<p><strong>Notes:</strong> { inv.Notes }</p>
					}
				</div>

				<h3>Line Items</h3>
				if len(inv.Lines) > 0 {
					<table>
						<thead>
							<tr>
								<th>Description</th>
								<th>Quantity</th>
								<th>Unit Price</th>
								<th>Total</th>
							</tr>
						</thead>
						<tbody>
							for _, l := range inv.Lines {
								<tr>
									<td>{ l.Description }</td>
									<td>{ fmt.Sprintf("%.2f", l.Quantity) }</td>
									<td>{ formatCents(l.UnitPrice) }</td>
									<td>{ formatCents(l.LineTotal) }</td>
								</tr>
							}
						</tbody>
					</table>
				} else {
					<p>No line items.</p>
				}

				<div class="invoice-totals">
					<p><strong>Subtotal:</strong> { formatCents(inv.Subtotal) }</p>
					<p><strong>Tax Rate:</strong> { fmt.Sprintf("%.2f%%", float64(inv.TaxRate)/100) }</p>
					<p><strong>Tax Amount:</strong> { formatCents(inv.TaxAmount) }</p>
					<p><strong>Total:</strong> { formatCents(inv.Total) }</p>
				</div>

			<div class="form-actions">
				if inv.Status == "draft" {
						<a href={ templ.URL(fmt.Sprintf("/invoices/%d/edit", inv.ID)) } class="btn">Edit Invoice</a>
				}
					<a href={ templ.URL(fmt.Sprintf("/invoices/%d/pdf", inv.ID)) } class="btn btn-warning">Download PDF</a>
				if inv.Status == "draft" && inv.Client.Email != "" {
					<button
						hx-post={ templ.URL(fmt.Sprintf("/invoices/%d/email", inv.ID)) }
						hx-swap="none"
						hx-confirm={ fmt.Sprintf("Email this invoice to %s?", inv.Client.Email) }
						class="btn btn-success"
					>Email Invoice</button>
				}
				<a href="/invoices" class="btn btn-secondary">Back to Invoices</a>
			</div>
			</main>
		</body>
	</html>
}

// EditInvoicePage renders the invoice form pre-filled for updating a draft invoice.
templ EditInvoicePage(clients []store.Client, services []store.Service, inv store.Invoice) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<title>Edit { inv.Number } — ginvoice</title>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body>
			@Nav()
			<main class="container">
				<h1>Edit Invoice { inv.Number }</h1>
				@InvoiceForm(clients, services, inv, fmt.Sprintf("/invoices/%d", inv.ID))
			</main>
		</body>
	</html>
}
