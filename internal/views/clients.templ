package views

import (
	"fmt"

	"ginvoice/internal/email"
	"ginvoice/internal/store"
)

// ClientsPage renders the full clients list page with an "Add Client" link.
templ ClientsPage(clients []store.Client) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<title>Clients — ginvoice</title>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/htmx.min.js"></script>
			@ThemeInit()
		</head>
		<body>
			@Nav()
			<main class="container">
				<h1>Clients</h1>
			<p><a href="/clients/new" class="btn btn-success">Add Client</a></p>
				if len(clients) == 0 {
					<p>No clients yet. Add your first client to get started.</p>
				} else {
					<table id="clients-table">
						<thead>
							<tr>
								<th>Name</th>
								<th>Company</th>
								<th>Email</th>
								<th>Phone</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, c := range clients {
								@ClientRow(c)
							}
						</tbody>
					</table>
				}
			</main>
		</body>
	</html>
}

// ClientRow renders a single table row for a client. The delete button
// posts to /clients/{id}/delete and swap-removes this row via HTMX.
templ ClientRow(c store.Client) {
	<tr id={ fmt.Sprintf("client-row-%d", c.ID) }>
		<td>{ c.Name }</td>
		<td>{ c.CompanyName }</td>
		<td>{ c.Email }</td>
		<td>{ c.Phone }</td>
		<td>
			<a href={ templ.URL(fmt.Sprintf("/clients/%d/edit", c.ID)) } class="btn btn-secondary">Edit</a>
			<button
				hx-post={ templ.URL(fmt.Sprintf("/clients/%d/delete", c.ID)) }
				hx-target={ fmt.Sprintf("#client-row-%d", c.ID) }
				hx-swap="outerHTML"
				hx-confirm="Delete this client?"
				class="btn btn-danger"
			>Delete</button>
		</td>
	</tr>
}

// ClientForm renders the add/edit form. action is "/clients" for create
// or "/clients/{id}" for update.
templ ClientForm(c store.Client, action string) {
	<form method="post" action={ templ.URL(action) } class="card">
		<label for="name">Name *</label>
		<input type="text" id="name" name="name" value={ c.Name } required/>

		<label for="company_name">Company</label>
		<input type="text" id="company_name" name="company_name" value={ c.CompanyName }/>

		<label for="address">Address</label>
		<textarea id="address" name="address">{ c.Address }</textarea>

		<label for="email">Email</label>
		<input type="email" id="email" name="email" value={ c.Email }/>

		<label for="phone">Phone</label>
		<input type="text" id="phone" name="phone" value={ c.Phone }/>

	<label for="tax_id">VAT/Tax ID</label>
	<input type="text" id="tax_id" name="tax_id" value={ c.TaxID }/>

	<label for="invoice_number_prefix">Invoice Number Prefix</label>
	<input type="text" id="invoice_number_prefix" name="invoice_number_prefix" value={ c.InvoiceNumberPrefix } placeholder="Leave blank to use company default"/>

	<label for="currency">Currency</label>
	<input type="text" id="currency" name="currency" value={ c.Currency } placeholder="EUR"/>

	<label for="invoice_notes">Invoice Notes (optional override)</label>
	<textarea id="invoice_notes" name="invoice_notes" rows="4" placeholder="Leave blank to use company default">{ c.InvoiceNotes }</textarea>

	<h3>Email Template (optional override)</h3>
		<small>Leave blank to use the company default. Variables: { "{{companyName}}, {{companyNameLink}}, {{companyWebsite}}, {{companyURL}}, {{companyPhone}}, {{companyAddressLine1}}, {{companyAddressLine2}}, {{companyPostalCode}}, {{companyCity}}, {{companyState}}, {{companyCountry}}, {{ownerFirstName}}, {{ownerLastName}}, {{invoiceNumber}}, {{clientName}}, {{invoiceTotal}}, {{invoiceDueDate}}" }</small>
		<label for="email_subject">Email Subject</label>
		<input type="text" id="email_subject" name="email_subject" value={ c.EmailSubject } placeholder={ email.DefaultSubject }/>

		<label for="email_body">Email Body (HTML)</label>
		<textarea id="email_body" name="email_body" rows="16" placeholder={ email.DefaultBody }>{ c.EmailBody }</textarea>
		<div class="email-preview-wrap">
			<small>Preview (sample data):</small>
			<iframe id="email-preview" style="width: 100%; height: 400px; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff;"></iframe>
		</div>

		<button type="submit">Save</button>
	</form>
}

// NewClientPage renders a blank client form for creating a client.
templ NewClientPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<title>New Client — ginvoice</title>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/htmx.min.js"></script>
			@ThemeInit()
		</head>
		<body>
			@Nav()
			<main class="container">
				<h1>Add Client</h1>
				@ClientForm(store.Client{}, "/clients")
			</main>
			<script>
				(function() {
					var lb = '{' + '{';
					var rb = '}' + '}';
					function renderPreview() {
						var body = document.querySelector('textarea[name="email_body"]');
						var subjInput = document.querySelector('input[name="email_subject"]');
						var preview = document.getElementById('email-preview');
						if (!body || !preview) return;
						function substitute(tmpl) {
							tmpl = tmpl.split(lb + 'companyNameLink' + rb).join('<a href="#">Your Company</a>');
							tmpl = tmpl.split(lb + 'companyName' + rb).join('Your Company');
							tmpl = tmpl.split(lb + 'companyWebsite' + rb).join('https://example.com');
							tmpl = tmpl.split(lb + 'companyURL' + rb).join('<a href="#">https://example.com</a>');
							tmpl = tmpl.split(lb + 'companyPhone' + rb).join('+1 555 000 0000');
						tmpl = tmpl.split(lb + 'companyAddressLine1' + rb).join('123 Main St');
						tmpl = tmpl.split(lb + 'companyAddressLine2' + rb).join('');
						tmpl = tmpl.split(lb + 'companyPostalCode' + rb).join('10001');
						tmpl = tmpl.split(lb + 'companyCity' + rb).join('Springfield');
						tmpl = tmpl.split(lb + 'companyState' + rb).join('');
						tmpl = tmpl.split(lb + 'companyCountry' + rb).join('USA');
							tmpl = tmpl.split(lb + 'ownerFirstName' + rb).join('John');
							tmpl = tmpl.split(lb + 'ownerLastName' + rb).join('Doe');
							tmpl = tmpl.split(lb + 'invoiceNumber' + rb).join('INV-2026-001');
							tmpl = tmpl.split(lb + 'clientName' + rb).join('Sample Client');
							tmpl = tmpl.split(lb + 'invoiceTotal' + rb).join('1,500.00');
							tmpl = tmpl.split(lb + 'invoiceDueDate' + rb).join('2026-09-21');
							return tmpl;
						}
						var subjectHtml = subjInput ? substitute(subjInput.value || subjInput.placeholder) : '';
						var bodyHtml = substitute(body.value || body.placeholder);
						preview.srcdoc = '<html><body style="font-family: sans-serif; margin: 0; padding: 12px; color: #1f2937; line-height: 1.5;">' +
							'<p style="font-weight: 600; margin: 0 0 8px; padding-bottom: 8px; border-bottom: 1px solid #e2e8f0;">' + subjectHtml + '</p>' +
							bodyHtml + '</body></html>';
					}
					document.addEventListener('input', function(e) {
						if (e.target.closest('form')) renderPreview();
					});
					renderPreview();
				})();
			</script>
		</body>
	</html>
}

// EditClientPage renders the client form pre-filled for updating a client.
templ EditClientPage(c store.Client) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<title>Edit Client — ginvoice</title>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/htmx.min.js"></script>
			@ThemeInit()
		</head>
		<body>
			@Nav()
			<main class="container">
				<h1>Edit Client</h1>
				@ClientForm(c, fmt.Sprintf("/clients/%d", c.ID))
			</main>
			<script>
				(function() {
					var lb = '{' + '{';
					var rb = '}' + '}';
					function renderPreview() {
						var body = document.querySelector('textarea[name="email_body"]');
						var subjInput = document.querySelector('input[name="email_subject"]');
						var preview = document.getElementById('email-preview');
						if (!body || !preview) return;
						function substitute(tmpl) {
							tmpl = tmpl.split(lb + 'companyNameLink' + rb).join('<a href="#">Your Company</a>');
							tmpl = tmpl.split(lb + 'companyName' + rb).join('Your Company');
							tmpl = tmpl.split(lb + 'companyWebsite' + rb).join('https://example.com');
							tmpl = tmpl.split(lb + 'companyURL' + rb).join('<a href="#">https://example.com</a>');
							tmpl = tmpl.split(lb + 'companyPhone' + rb).join('+1 555 000 0000');
						tmpl = tmpl.split(lb + 'companyAddressLine1' + rb).join('123 Main St');
						tmpl = tmpl.split(lb + 'companyAddressLine2' + rb).join('');
						tmpl = tmpl.split(lb + 'companyPostalCode' + rb).join('10001');
						tmpl = tmpl.split(lb + 'companyCity' + rb).join('Springfield');
						tmpl = tmpl.split(lb + 'companyState' + rb).join('');
						tmpl = tmpl.split(lb + 'companyCountry' + rb).join('USA');
							tmpl = tmpl.split(lb + 'ownerFirstName' + rb).join('John');
							tmpl = tmpl.split(lb + 'ownerLastName' + rb).join('Doe');
							tmpl = tmpl.split(lb + 'invoiceNumber' + rb).join('INV-2026-001');
							tmpl = tmpl.split(lb + 'clientName' + rb).join('Sample Client');
							tmpl = tmpl.split(lb + 'invoiceTotal' + rb).join('1,500.00');
							tmpl = tmpl.split(lb + 'invoiceDueDate' + rb).join('2026-09-21');
							return tmpl;
						}
						var subjectHtml = subjInput ? substitute(subjInput.value || subjInput.placeholder) : '';
						var bodyHtml = substitute(body.value || body.placeholder);
						preview.srcdoc = '<html><body style="font-family: sans-serif; margin: 0; padding: 12px; color: #1f2937; line-height: 1.5;">' +
							'<p style="font-weight: 600; margin: 0 0 8px; padding-bottom: 8px; border-bottom: 1px solid #e2e8f0;">' + subjectHtml + '</p>' +
							bodyHtml + '</body></html>';
					}
					document.addEventListener('input', function(e) {
						if (e.target.closest('form')) renderPreview();
					});
					renderPreview();
				})();
			</script>
		</body>
	</html>
}
