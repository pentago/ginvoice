package views

import "ginvoice/internal/store"
import "ginvoice/internal/email"
import "ginvoice/internal/pdf"
import "fmt"

templ SettingsPage(c store.Company, cfg pdf.TemplateConfig, fonts []string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<title>Settings — ginvoice</title>
		<link rel="stylesheet" href="/static/style.css"/>
		<script src="/static/htmx.min.js"></script>
		@ThemeInit()
	</head>
	<body>
		@Nav()
		<main class="container">
			<h1>Company Settings</h1>
			@SettingsForm(c, cfg, fonts, "")
		</main>
		<script>
			(function() {
				var lb = '{' + '{';
				var rb = '}' + '}';

				function renderPreview() {
					var body = document.querySelector('textarea[name="default_email_body"]');
					var subjInput = document.querySelector('input[name="default_email_subject"]');
					var preview = document.getElementById('email-preview');
					if (!body || !preview) return;
					var name = document.querySelector('input[name="name"]');
					var ofn = document.querySelector('input[name="owner_first_name"]');
					var oln = document.querySelector('input[name="owner_last_name"]');
					var website = document.querySelector('input[name="website"]');
					var phone = document.querySelector('input[name="phone"]');
					var line1 = document.querySelector('input[name="address_line1"]');
					var line2 = document.querySelector('input[name="address_line2"]');
					var postal = document.querySelector('input[name="postal_code"]');
					var city = document.querySelector('input[name="city"]');
					var state = document.querySelector('input[name="state"]');
					var country = document.querySelector('input[name="country"]');
					var companyName = name ? (name.value || 'Your Company') : 'Your Company';
					var site = website ? (website.value || '') : '';
					var companyNameLink = site ? '<a href="' + site + '">' + companyName + '</a>' : companyName;
					var companyURL = site ? '<a href="' + site + '">' + site + '</a>' : '';

					function substitute(tmpl) {
						tmpl = tmpl.split(lb + 'companyNameLink' + rb).join(companyNameLink);
						tmpl = tmpl.split(lb + 'companyName' + rb).join(companyName);
						tmpl = tmpl.split(lb + 'companyWebsite' + rb).join(site);
						tmpl = tmpl.split(lb + 'companyURL' + rb).join(companyURL);
						tmpl = tmpl.split(lb + 'companyPhone' + rb).join(phone ? (phone.value || '+1 555 000 0000') : '+1 555 000 0000');
						tmpl = tmpl.split(lb + 'companyAddressLine1' + rb).join(line1 ? (line1.value || '123 Main St') : '123 Main St');
						tmpl = tmpl.split(lb + 'companyAddressLine2' + rb).join(line2 ? line2.value : '');
						tmpl = tmpl.split(lb + 'companyPostalCode' + rb).join(postal ? (postal.value || '10001') : '10001');
						tmpl = tmpl.split(lb + 'companyCity' + rb).join(city ? (city.value || 'Springfield') : 'Springfield');
						tmpl = tmpl.split(lb + 'companyState' + rb).join(state ? state.value : '');
						tmpl = tmpl.split(lb + 'companyCountry' + rb).join(country ? (country.value || 'USA') : 'USA');
						tmpl = tmpl.split(lb + 'ownerFirstName' + rb).join(ofn ? (ofn.value || 'John') : 'John');
						tmpl = tmpl.split(lb + 'ownerLastName' + rb).join(oln ? (oln.value || 'Doe') : 'Doe');
						tmpl = tmpl.split(lb + 'invoiceNumber' + rb).join('INV-2026-001');
						tmpl = tmpl.split(lb + 'clientName' + rb).join('Sample Client');
						tmpl = tmpl.split(lb + 'invoiceTotal' + rb).join('1,500.00');
						tmpl = tmpl.split(lb + 'invoiceDueDate' + rb).join('2026-09-21');
						return tmpl;
					}

					var subjectHtml = subjInput ? substitute(subjInput.value || subjInput.placeholder) : '';
					var bodyHtml = substitute(body.value || body.placeholder);
					preview.srcdoc = '<html><body style="font-family: sans-serif; margin: 0; padding: 12px; color: #1f2937; line-height: 1.5;">' +
						'<p style="font-weight: 600; margin: 0 0 8px; padding-bottom: 8px; border-bottom: 1px solid #e2e8f0;">' + subjectHtml + '</p>' +
						bodyHtml +
					'</body></html>';
				}


				document.addEventListener('input', function(e) {
					if (e.target.closest('form')) {
						renderPreview();
					}
				});
				document.addEventListener('htmx:afterSwap', renderPreview);
				renderPreview();
			})();
			</script>
	</body>
	</html>
}

templ SettingsForm(c store.Company, cfg pdf.TemplateConfig, fonts []string, saveErr string) {
	<form
		hx-post="/company"
		hx-swap="outerHTML"
		enctype="multipart/form-data"
		class="card"
	>
		if saveErr != "" {
			<p class="alert alert-error">{ saveErr }</p>
		}
		<label>Company Name *<br/>
			<input type="text" name="name" value={ c.Name } required/>
		</label>
		<div class="form-row">
			<div class="form-group">
				<label>Owner First Name<br/>
					<input type="text" name="owner_first_name" value={ c.OwnerFirstName }/>
				</label>
			</div>
			<div class="form-group">
				<label>Owner Last Name<br/>
					<input type="text" name="owner_last_name" value={ c.OwnerLastName }/>
				</label>
			</div>
		</div>
		<label>Website<br/>
			<input type="url" name="website" value={ c.Website } placeholder="https://example.com"/>
		</label>
	<label>Address Line 1<br/>
		<input type="text" name="address_line1" value={ c.AddressLine1 }/>
	</label>
	<label>Address Line 2<br/>
		<input type="text" name="address_line2" value={ c.AddressLine2 }/>
	</label>
	<div class="form-row">
		<div class="form-group">
			<label>Postal Code<br/>
				<input type="text" name="postal_code" value={ c.PostalCode }/>
			</label>
		</div>
		<div class="form-group">
			<label>City<br/>
				<input type="text" name="city" value={ c.City }/>
			</label>
		</div>
	</div>
	<div class="form-row">
		<div class="form-group">
			<label>State<br/>
				<input type="text" name="state" value={ c.State }/>
			</label>
		</div>
		<div class="form-group">
			<label>Country<br/>
				<input type="text" name="country" value={ c.Country }/>
			</label>
		</div>
	</div>
		<label>Email<br/>
			<input type="email" name="email" value={ c.Email }/>
		</label>
		<label>Phone<br/>
			<input type="text" name="phone" value={ c.Phone }/>
		</label>
		<label>VAT/Tax ID<br/>
			<input type="text" name="tax_id" value={ c.TaxID }/>
		</label>
		<label>IBAN<br/>
			<input type="text" name="iban" value={ c.IBAN }/>
		</label>
		<label>Default Tax Rate (%)<br/>
			<input type="number" step="0.01" name="default_tax_rate_pct"
				value={ fmt.Sprintf("%.2f", float64(c.DefaultTaxRateBPS)/100) }/>
		</label>
		<label>Logo<br/>
			<input type="file" name="logo" accept="image/*"/>
			if c.LogoData != "" {
				<br/>
				<img src={ c.LogoData } alt="logo" style="max-height: 80px; max-width: 200px; margin-top: 0.5rem; border: 1px solid #dbe3ee; border-radius: 8px; padding: 4px;"/>
			}
		</label>
	<label>Invoice Notes<br/>
		<textarea name="invoice_notes" rows="6" placeholder={ store.DefaultInvoiceNotes }>{ c.InvoiceNotes }</textarea>
		<small>Supports the same variables as email templates. Leave blank to use the built-in default.</small>
	</label>
		<h3>Default Email Template</h3>
		<small>Used when a client has no custom template. Variables: { "{{companyName}}, {{companyNameLink}}, {{companyWebsite}}, {{companyURL}}, {{companyPhone}}, {{companyAddressLine1}}, {{companyAddressLine2}}, {{companyPostalCode}}, {{companyCity}}, {{companyState}}, {{companyCountry}}, {{ownerFirstName}}, {{ownerLastName}}, {{invoiceNumber}}, {{clientName}}, {{invoiceTotal}}, {{invoiceDueDate}}" }</small>
		<label>Default Email Subject<br/>
			<input type="text" name="default_email_subject" value={ c.DefaultEmailSubject } placeholder={ email.DefaultSubject }/>
		</label>
		<label>Default Email Body (HTML)<br/>
			<textarea name="default_email_body" rows="16" placeholder={ email.DefaultBody }>{ c.DefaultEmailBody }</textarea>
		</label>
		<div class="email-preview-wrap">
			<small>Preview (sample data):</small>
			<iframe id="email-preview" style="width: 100%; height: 400px; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff;"></iframe>
		</div>
		<h3>PDF Style</h3>
		<small>Leave blank to inherit the default font. Fonts download from Google Fonts on save.</small>
		<datalist id="font-catalog">
			for _, f := range fonts {
				<option value={ f }/>
			}
		</datalist>
		<div class="form-row">
			<div class="form-group">
				<label>Default font<br/>
					<input type="text" name="font_family" list="font-catalog" value={ cfg.FontFamily } placeholder="DejaVu Sans"/>
				</label>
			</div>
			<div class="form-group">
				<label>Title font<br/>
					<input type="text" name="font_title" list="font-catalog" value={ cfg.FontTitle } placeholder="DejaVu Sans"/>
				</label>
			</div>
		</div>
		<div class="form-row">
			<div class="form-group">
				<label>Details font<br/>
					<input type="text" name="font_details" list="font-catalog" value={ cfg.FontDetails } placeholder="DejaVu Sans"/>
				</label>
			</div>
			<div class="form-group">
				<label>Body font<br/>
					<input type="text" name="font_body" list="font-catalog" value={ cfg.FontBody } placeholder="DejaVu Sans"/>
				</label>
			</div>
		</div>
		<div class="form-row">
			<div class="form-group">
				<label>Notes font<br/>
					<input type="text" name="font_notes" list="font-catalog" value={ cfg.FontNotes } placeholder="DejaVu Sans"/>
				</label>
			</div>
		</div>
		<div class="form-row">
			<div class="form-group">
				<label>Accent color<br/>
					<input type="color" name="accent_color" value={ cfg.AccentColor }/>
				</label>
			</div>
			<div class="form-group">
				<label>Text color<br/>
					<input type="color" name="text_color" value={ cfg.TextColor }/>
				</label>
			</div>
			<div class="form-group">
				<label>Muted color<br/>
					<input type="color" name="muted_color" value={ cfg.MutedColor }/>
				</label>
			</div>
		</div>
		<div class="form-row">
			<div class="form-group">
				<label>Divider color<br/>
					<input type="color" name="divider_color" value={ cfg.DividerColor }/>
				</label>
			</div>
			<div class="form-group">
				<label>Table header color<br/>
					<input type="color" name="table_header_color" value={ cfg.TableHeaderColor }/>
				</label>
			</div>
			<div class="form-group">
				<label>Table header background<br/>
					<input type="text" name="table_header_bg" value={ cfg.TableHeaderBg } placeholder="empty = transparent"/>
				</label>
			</div>
		</div>
		<div class="form-row">
			<div class="form-group">
				<label>Heading size<br/>
					<input type="number" step="0.5" min="1" name="heading_size" value={ fmt.Sprintf("%g", cfg.HeadingSize) }/>
				</label>
			</div>
			<div class="form-group">
				<label>Body size<br/>
					<input type="number" step="0.5" min="1" name="body_size" value={ fmt.Sprintf("%g", cfg.BodySize) }/>
				</label>
			</div>
			<div class="form-group">
				<label>Label size<br/>
					<input type="number" step="0.5" min="1" name="label_size" value={ fmt.Sprintf("%g", cfg.LabelSize) }/>
				</label>
			</div>
		</div>
		<div class="form-row">
			<div class="form-group">
				<label>Margin (mm)<br/>
					<input type="number" step="1" min="0" name="margin_mm" value={ fmt.Sprintf("%g", cfg.MarginMM) }/>
				</label>
			</div>
		</div>
		<label>
			<input type="checkbox" name="show_notes"
				if cfg.ShowNotes {
					checked
				}
			/> Show notes section on invoices
		</label>
		<button type="submit">Save</button>
	</form>
}

templ SettingsSaved(c store.Company, cfg pdf.TemplateConfig, fonts []string) {
	<div id="settings-saved">
		<p>✓ Settings saved for <strong>{ c.Name }</strong></p>
		@SettingsForm(c, cfg, fonts, "")
	</div>
}
